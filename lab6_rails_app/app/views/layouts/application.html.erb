
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Аптека онлайн" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="bg-success text-white py-4">
      <div class="container">
        <h1 class="h3 mb-2">Аптека онлайн</h1>
        <p class="mb-0">
          Графік чергових аптек: щодня, 08:00–22:00
        </p>
      </div>
    </header>

    <nav class="navbar navbar-expand-lg bg-light border-bottom">
      <div class="container">
        <%= link_to "Аптека", medicines_path,
            class: "navbar-brand fw-bold" %>

        <div class="navbar-nav flex-row flex-wrap gap-3 align-items-center">
          <%= link_to "Про проєкт", pages_about_path,
              class: "nav-link" %>

          <%= link_to "Усі препарати", medicines_path,
              class: "nav-link" %>

          <%= link_to "Рецептурні",
              medicines_path(category: "Рецептурні"),
              class: "nav-link" %>

          <%= link_to "Безрецептурні",
              medicines_path(category: "Безрецептурні"),
              class: "nav-link" %>

          <% if user_signed_in? %>
            <%= link_to "Додати препарат",
                new_medicine_path,
                class: "nav-link" %>

            <%= link_to "Мій профіль", profile_path,
                class: "nav-link" %>

            <span class="navbar-text">
              <%= current_user.name %>
            </span>

            <%= button_to "Вийти",
                destroy_user_session_path,
                method: :delete,
                class: "btn btn-outline-danger btn-sm" %>

            <% if current_user.admin? %>
              <%= button_to "Видалити всі",
                  delete_all_medicines_path,
                  method: :delete,
                  class: "btn btn-danger btn-sm",
                  form: {
                    data: {
                      turbo_confirm: "Видалити всі препарати?"
                    }
                  } %>
            <% end %>
          <% else %>
            <%= link_to "Увійти",
                new_user_session_path,
                class: "btn btn-outline-primary btn-sm" %>

            <%= link_to "Реєстрація",
                new_user_registration_path,
                class: "btn btn-success btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-dark text-white py-4 mt-5">
      <div class="container text-center">
        <h5>Аптека онлайн</h5>

        <p class="mb-2">
          Увага! Самолікування може бути шкідливим для вашого здоров'я.
          Перед застосуванням лікарських засобів
          проконсультуйтеся з лікарем.
        </p>

        <hr>

        <p class="mb-1">
          Розробник: Михайло Венгринович
        </p>

        <p class="mb-0">
          Навчальний проєкт Ruby on Rails — 2026
        </p>
      </div>
    </footer>
  </body>
</html>
